<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>gcpEncrypt</AssemblyName>
    <RootNamespace>GcpEncrypt</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Encrypts a GS1 GCPPrefixFormatList XML into the GCP1 AES-256-GCM envelope and emits gcpMeta.json for the update service.</Description>
  </PropertyGroup>

</Project>
