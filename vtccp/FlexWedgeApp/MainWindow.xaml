<Window x:Class="FlexWedgeApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VCCS FlexWedge 1.0.0" Width="1100" Height="760">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
  <TextBlock FontSize="20" FontWeight="Bold" Text="FlexWedge / focused VeriWedge RFID"/>
  <TextBlock x:Name="StatusText" Margin="0,4" TextWrapping="Wrap"/>
  <GroupBox Header="ASR-P35U reader (single reader / single trigger)" Margin="0,8"><WrapPanel Margin="8">
   <TextBlock VerticalAlignment="Center" Text="COM port:"/><TextBox x:Name="PortBox" Width="90" Margin="5,0"/>
   <Button Content="Connect" Click="Connect_Click" Margin="4"/><Button Content="Disconnect" Click="Disconnect_Click" Margin="4"/><Button Content="Single trigger" Click="Trigger_Click" Margin="4"/>
  </WrapPanel></GroupBox>
  <GroupBox Header="Manual EPC input (regression/demo without hardware)" Margin="0,4"><DockPanel Margin="8">
   <Button DockPanel.Dock="Right" Content="Process EPC" Click="ProcessManual_Click" Margin="6,0,0,0"/><TextBox x:Name="ManualEpcBox"/>
  </DockPanel></GroupBox>
   <GroupBox Header="Output profile and destination" Margin="0,4"><StackPanel Margin="8"><WrapPanel>
   <ComboBox x:Name="ProfileBox" Width="180" SelectionChanged="ProfileChanged"/><TextBlock VerticalAlignment="Center" Text=" Prefix:"/><TextBox x:Name="PrefixBox" Width="70"/><TextBlock VerticalAlignment="Center" Text=" Suffix:"/><TextBox x:Name="SuffixBox" Width="70"/><TextBlock VerticalAlignment="Center" Text=" Delimiter:"/><TextBox x:Name="DelimiterBox" Width="50" Text="\t"/><ComboBox x:Name="AppendBox" Width="70" Margin="5,0"/><Button Content="Save config" Click="SaveConfig_Click" Margin="8,0"/>
   <Button Content="Copy to Clipboard" Click="Copy_Click" Margin="4"/><Button Content="Send to Previously Focused Application" Click="Send_Click" Margin="4"/>
   </WrapPanel><DockPanel Margin="0,6,0,0"><TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="Fields/header mapping: "/><TextBox x:Name="MappingBox" ToolTip="Semicolon-separated Field=Header entries; order controls output columns."/></DockPanel></StackPanel></GroupBox>
  <GroupBox Header="GCP prefix table" Margin="0,4"><WrapPanel Margin="8"><TextBox x:Name="GcpPathBox" Width="500"/><Button Content="Browse custom XML" Click="BrowseGcp_Click" Margin="5,0"/><Button Content="Reload GCP" Click="ReloadGcp_Click" Margin="5,0"/></WrapPanel></GroupBox>
  <GroupBox Header="Decoded canonical result" Margin="0,4"><TextBox x:Name="ResultBox" Margin="8" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" MinHeight="190"/></GroupBox>
  <GroupBox Header="VeriWedge boundary - optional one barcode GS1 input compared to one RFID EPC" Margin="0,4"><DockPanel Margin="8"><Button DockPanel.Dock="Right" Content="Validate one tag" Click="Validate_Click" Margin="6,0,0,0"/><TextBox x:Name="BarcodeBox" ToolTip="GS1 element string or Digital Link"/></DockPanel></GroupBox>
  <TextBlock x:Name="ValidationText" Margin="4" TextWrapping="Wrap"/>
  <GroupBox Header="Session reads" Margin="0,4"><DockPanel Margin="8"><Button DockPanel.Dock="Right" Content="Export CSV / JSONL" Click="Export_Click"/><TextBlock x:Name="SessionText" Text="0 reads"/></DockPanel></GroupBox>
  <ListBox x:Name="RecentList" Height="110"/>
 </StackPanel></ScrollViewer>
</Window>