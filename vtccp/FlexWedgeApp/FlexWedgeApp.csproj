<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.18362.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FlexWedge</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>VCCS</Company>
    <Product>VCCS FlexWedge</Product>
    <Description>Focused RFID wedge and VeriWedge validation application</Description>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\lib\asreader-p3xu-sdk-1.3.0\AsReaderP3xU.dll')">
    <DefineConstants>$(DefineConstants);ASREADER_SDK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeviceInterface\DeviceInterface.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="flexwedge.config.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\data\gcp-prefix-format-list.xml" Link="data\gcp-prefix-format-list.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>