<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DeviceInterface</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <!-- System.Drawing and Cognex SDK are Windows-only; this library only runs
         on Windows. Suppress CA1416 platform-compatibility warnings. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExcelEngine\ExcelEngine.csproj" />
  </ItemGroup>

  <!-- System.Drawing.Common — required for Bitmap-based image loading
       in TryLoadImageViaReflection (Windows only; same constraint as SDK). -->
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.1" />
  </ItemGroup>

  <!-- System.IO.Ports — for MtiLlcsEpcReader serial port communication.
       Included in-box on .NET 8 Windows; explicit reference for portability. -->
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <!-- Cognex DataMan SDK — ships with DataMan Software (DMST).
       Port 44444 binary protocol; replaces our raw ASCII DmccClient. -->
  <ItemGroup>
    <Reference Include="Cognex.DataMan.SDK.PC">
      <HintPath>C:\Program Files (x86)\Cognex\DataMan\DataMan Software v25.4.1\Cognex.DataMan.SDK.PC.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
