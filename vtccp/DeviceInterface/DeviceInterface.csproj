<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DeviceInterface</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <!-- System.Drawing and Cognex SDK are Windows-only; this library only runs
         on Windows. Suppress CA1416 platform-compatibility warnings. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExcelEngine\ExcelEngine.csproj" />
  </ItemGroup>

  <!-- System.Drawing.Common — required for Bitmap-based image loading
       in TryLoadImageViaReflection (Windows only; same constraint as SDK). -->
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.1" />
  </ItemGroup>

  <!-- System.IO.Ports — for MtiLlcsEpcReader serial port communication.
       Included in-box on .NET 8 Windows; explicit reference for portability. -->
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <!-- Microsoft.Web.WebView2 — Edge-based HTML→PDF rendering (Core only; no
       WinForms/WPF dependency).  Used by VccsPdfRenderer.PrintToPdfAsync. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
  </ItemGroup>

  <!-- PdfSharp-MigraDoc-GDI — MIT-licensed PDF manipulation.
       Used by PdfReportGenerator.MergeAsync to append the VCCS page to the Webscan PDF. -->
  <ItemGroup>
    <PackageReference Include="PdfSharp-MigraDoc-GDI" Version="6.2.0" />
  </ItemGroup>

  <!-- Cognex DataMan SDK — ships with DataMan Software (DMST).
       Port 44444 binary protocol; replaces our raw ASCII DmccClient.
       Excluded from build when the DLL is absent (CI / Linux / test runs). -->
  <ItemGroup Condition="Exists('C:\Program Files (x86)\Cognex\DataMan\DataMan Software v25.4.1\Cognex.DataMan.SDK.PC.dll')">
    <Reference Include="Cognex.DataMan.SDK.PC">
      <HintPath>C:\Program Files (x86)\Cognex\DataMan\DataMan Software v25.4.1\Cognex.DataMan.SDK.PC.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <!-- Exclude SDK-dependent files when the Cognex DLL is absent so the pure C#
       core (EpcParser, decoders, models, validators) builds for unit tests on
       non-Windows / CI machines. -->
  <ItemGroup Condition="!Exists('C:\Program Files (x86)\Cognex\DataMan\DataMan Software v25.4.1\Cognex.DataMan.SDK.PC.dll')">
    <Compile Remove="Dmcc/DataManSdkClient.cs" />
    <Compile Remove="DeviceSession.cs" />
    <Compile Remove="NetworkDiscoverer.cs" />
  </ItemGroup>

  <!-- vccs-report-template.html — HTML template for the VCCS RFID Validation Report.
       Loaded at runtime by VccsHtmlReportGenerator via GetManifestResourceStream.
       ALL visual/layout changes go here; C# only substitutes {{TOKEN}} markers. -->
  <ItemGroup>
    <EmbeddedResource Include="Reports/vccs-report-template.html" />
  </ItemGroup>

  <!-- AsReader ASR-P35U SDK — canonical VCCS RFID reader hardware (confirmed 2026-08-06).
       DLL not committed; place AsReaderP3xU.dll in vtccp\lib\asreader-p3xu-sdk-1.3.0\
       before building — see PLACE-DLL-HERE.md in that folder.
       Targets .NET Framework 4.x; compatible with .NET 8 via framework compatibility shim.
       Excluded from build when the DLL is absent (CI / Linux / test runs). -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\lib\asreader-p3xu-sdk-1.3.0\AsReaderP3xU.dll')">
    <Reference Include="AsReaderP3xU">
      <HintPath>..\lib\asreader-p3xu-sdk-1.3.0\AsReaderP3xU.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <!-- Exclude AsReaderP35UEpcReader and EpcReaderFactory (which references it)
       when the SDK DLL is absent. -->
  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)..\lib\asreader-p3xu-sdk-1.3.0\AsReaderP3xU.dll')">
    <Compile Remove="Rfid/AsReaderP35UEpcReader.cs" />
    <Compile Remove="Rfid/EpcReaderFactory.cs" />
  </ItemGroup>

  <!-- Exclude archived files — they are kept for reference only and must never
       block clean builds (e.g. raw-string-literal whitespace errors in CS files). -->
  <ItemGroup>
    <Compile Remove="Reports/_archived/**/*.cs" />
  </ItemGroup>

  <!-- Allow the unit-test project to access internal members (ParseHtml, validators). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DeviceInterface.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
