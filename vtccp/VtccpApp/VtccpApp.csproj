<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.18362.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VtccpApp</RootNamespace>
    <AssemblyName>VtccpApp</AssemblyName>
    <Version>1.5.86</Version>
    <Company>VCCS</Company>
    <Product>VTCCP</Product>
    <Description>VCCS DMV TruCheck Command Pilot</Description>
  </PropertyGroup>

  <!-- Mirror DeviceInterface's AsReader SDK guard: define ASREADER_SDK when the
       DLL is present so VtccpApp can conditionally compile RFID startup code. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\lib\asreader-p3xu-sdk-1.3.0\AsReaderP3xU.dll')">
    <DefineConstants>$(DefineConstants);ASREADER_SDK</DefineConstants>
  </PropertyGroup>

  <!-- Match DeviceInterface's Cognex SDK guard so SDK-dependent WPF actions
       compile only when their vendor DLL is available. -->
  <PropertyGroup Condition="Exists('C:\Program Files (x86)\Cognex\DataMan\DataMan Software v25.4.1\Cognex.DataMan.SDK.PC.dll')">
    <DefineConstants>$(DefineConstants);COGNEX_SDK</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="7.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExcelEngine\ExcelEngine.csproj" />
    <ProjectReference Include="..\DeviceInterface\DeviceInterface.csproj" />
    <ProjectReference Include="..\ConfigEngine\ConfigEngine.csproj" />
    <ProjectReference Include="..\OcrEngine\OcrEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- VCCS diamond logo — loaded by VccsHtmlReportGenerator at <ExeDir>/resources/vccs_logo.png -->
    <Content Include="..\DeviceInterface\Resources\vccs_logo.png">
      <Link>resources\vccs_logo.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- PIPS company logo — default company-box logo, base64-inlined into the v23 report -->
    <Content Include="..\DeviceInterface\Resources\pips_logo.png">
      <Link>resources\pips_logo.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- wkhtmltopdf — silent HTML→PDF fallback when WebView2 runtime is absent -->
    <Content Include="..\DeviceInterface\Resources\wkhtmltopdf.exe">
      <Link>resources\wkhtmltopdf.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\OcrEngine\tessdata\eng.traineddata">
      <Link>tessdata\eng.traineddata</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Official GS1 Syntax Engine native dependency and its AI dictionary.
         The validation service reports UNAVAILABLE instead of PASS if either is
         absent at runtime. -->
    <Content Include="..\lib\gs1-syntax-engine\dotnet-lib-release\runtimes\win-x64\native\gs1encoders.dll">
      <Link>gs1encoders.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\lib\gs1-syntax-engine\dotnet-lib-release\gs1-syntax-dictionary.txt">
      <Link>gs1-syntax-dictionary.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Bundled GS1 GCP Prefix Format List (seed copy; GcpUpdateService replaces with downloads) -->
    <Content Include="..\data\gcp-prefix-format-list.xml">
      <Link>data\gcp-prefix-format-list.xml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
