<Window x:Class="VtccpApp.Views.StitchingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Symbol Stitching"
        Width="1280" Height="720"
        MinWidth="860" MinHeight="520"
        Background="{StaticResource SurfaceBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- header -->
            <RowDefinition Height="*"    />   <!-- three image panels -->
            <RowDefinition Height="Auto" />   <!-- seam slider (conditional) -->
            <RowDefinition Height="Auto" />   <!-- result row -->
            <RowDefinition Height="Auto" />   <!-- status bar -->
            <RowDefinition Height="Auto" />   <!-- button bar -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock Text="Symbol Stitching"
                       Style="{StaticResource SectionHeader}" />
            <TextBlock DockPanel.Dock="Right"
                       Text="Capture left half → right half → adjust seam → verify"
                       VerticalAlignment="Bottom"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,3" />
        </DockPanel>

        <!-- Three image panels: Left | Composite | Right -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left half -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Image Source="{Binding LeftImage}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Left half&#x0a;(not yet captured)"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LeftImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            Background="#88000000" Padding="6,3">
                        <TextBlock Text="LEFT" FontSize="11" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Composite -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Image Source="{Binding CompositeImage}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Composite&#x0a;(preview after both halves captured)"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CompositeImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            Background="#88000000" Padding="6,3">
                        <TextBlock Text="COMPOSITE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Right half -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Image Source="{Binding RightImage}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Right half&#x0a;(not yet captured)"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RightImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            Background="#88000000" Padding="6,3">
                        <TextBlock Text="RIGHT" FontSize="11" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Seam slider — visible only when both halves captured -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Margin="0,0,0,8"
                Padding="12,8"
                Visibility="{Binding SeamSliderVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Seam position:"
                           FontSize="13" VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="{Binding SeamMax}"
                        Value="{Binding SeamPosition, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        TickFrequency="10"
                        IsSnapToTickEnabled="False" />
                <TextBlock Grid.Column="2"
                           Text="{Binding SeamPosition, StringFormat={}{0} px}"
                           FontSize="13" VerticalAlignment="Center"
                           Margin="10,0,0,0" MinWidth="55" />
            </Grid>
        </Border>

        <!-- Result row -->
        <Border Grid.Row="3"
                Style="{StaticResource Card}"
                Margin="0,0,0,8"
                Padding="12,8"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ResultText}"
                       FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="4"
                Style="{StaticResource Card}"
                Margin="0,0,0,10"
                Padding="10,7">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="13"
                       FontStyle="Italic"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Button bar -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Capture Left"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding CaptureLeftCommand}"
                    Padding="14,8" Margin="0,0,8,0" MinWidth="110" />
            <Button Content="Capture Right"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding CaptureRightCommand}"
                    Padding="14,8" Margin="0,0,8,0" MinWidth="110" />
            <Button Content="Preview Stitch"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding PreviewCommand}"
                    Padding="14,8" Margin="0,0,8,0" MinWidth="110" />
            <Button Content="Verify"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding VerifyCommand}"
                    Padding="18,8" Margin="0,0,8,0" MinWidth="80" />
            <Button Content="Reset"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ResetCommand}"
                    Padding="14,8" MinWidth="80" />
        </StackPanel>
    </Grid>
</Window>
