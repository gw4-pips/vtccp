<Window x:Class="VtccpApp.Views.LiveFeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live View"
        Width="920" Height="700"
        MinWidth="580" MinHeight="460"
        Background="{StaticResource SurfaceBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- header -->
            <RowDefinition Height="*"    />   <!-- image panel -->
            <RowDefinition Height="Auto" />   <!-- status bar -->
            <RowDefinition Height="Auto" />   <!-- button bar -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Live View"
                   Style="{StaticResource SectionHeader}"
                   Margin="0,0,0,12" />

        <!-- ── Image panel ──────────────────────────────────────────────── -->
        <!--
            Left-click + drag  : draw a free-form ROI rectangle.
            Right-click        : clear the current ROI.
            The rubber-band and finalized ROI rectangle are rendered on a Canvas
            overlay (IsHitTestVisible=False) inside this Grid so they never
            interfere with mouse capture on the outer Grid.
        -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Margin="0,0,0,10"
                Padding="0">
            <Grid x:Name="ImagePanel"
                  Cursor="Crosshair"
                  MouseLeftButtonDown="OnPanelLeftDown"
                  MouseMove="OnPanelMouseMove"
                  MouseLeftButtonUp="OnPanelLeftUp"
                  MouseLeave="OnPanelMouseLeave"
                  MouseRightButtonUp="OnPanelRightUp">

                <!-- Camera image -->
                <Image Source="{Binding LiveImage}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Placeholder shown until first IMAGE.SEND frame arrives -->
                <TextBlock Text="No image — press Go Live to start the camera feed."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LiveImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Overlay canvas — ROI rubber-band + finalized ROI rectangle.
                     IsHitTestVisible=False so mouse events pass through to the Grid. -->
                <Canvas x:Name="RoiCanvas" IsHitTestVisible="False">
                    <!-- Rubber-band / finalized ROI rectangle.
                         Positioned by code-behind via Canvas.Left/Top + Width/Height. -->
                    <Rectangle x:Name="RoiBand"
                               Stroke="#E0FFA020"
                               StrokeThickness="1.5"
                               StrokeDashArray="6 3"
                               Fill="#14FFA020"
                               Visibility="Collapsed" />

                    <!-- ROI cleared label (shown briefly on right-click clear) -->
                    <Border x:Name="RoiClearedHint"
                            Background="#CC1A1A1A"
                            CornerRadius="3"
                            Padding="8,4"
                            Visibility="Collapsed">
                        <TextBlock Text="ROI cleared"
                                   FontSize="11"
                                   Foreground="#BDFFA020" />
                    </Border>
                </Canvas>

                <!-- Crosshair — 1.5 px solid lines, centred, full-span, no hit test -->
                <Grid IsHitTestVisible="False">
                    <Rectangle Width="1.5"
                               HorizontalAlignment="Center"
                               SnapsToDevicePixels="True"
                               Fill="#A0FF3030" />
                    <Rectangle Height="1.5"
                               VerticalAlignment="Center"
                               SnapsToDevicePixels="True"
                               Fill="#A0FF3030" />
                    <!-- Small centre dot for precise aim point -->
                    <Ellipse Width="5" Height="5"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Fill="#FFFF3030"
                             SnapsToDevicePixels="True" />
                </Grid>

            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Margin="0,0,0,10"
                Padding="10,7">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="13"
                       FontStyle="Italic"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Button bar -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{Binding GoLiveVerifyLabel}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding GoLiveVerifyCommand}"
                    Padding="20,8"
                    Margin="0,0,10,0"
                    MinWidth="110" />
            <Button Content="Cancel Live Feed"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}"
                    Padding="16,8"
                    MinWidth="140" />
        </StackPanel>
    </Grid>
</Window>
