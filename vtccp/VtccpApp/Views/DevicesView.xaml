<UserControl x:Class="VtccpApp.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VtccpApp.ViewModels"
             Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Device Profiles"
                       Style="{StaticResource SectionHeader}"
                       Margin="0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Button Content="+ Add"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Edit"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding EditCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Duplicate"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding DuplicateCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Delete"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding DeleteCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Set Default"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding DefaultCommand}"
                        Margin="0,0,16,0" />
                <Button Content="⚡ Test Connection"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding TestConnectCommand}"
                        Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding ScanNetworkCommand}">
                    <Button.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="🔍 Scan Network" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Text" Value="Scanning…" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.Content>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- ── Discovery results panel ─────────────────────────────── -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12,10"
                Background="#EBF5FB"
                BorderBrush="#85C1E9"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding HasDiscoveredDevices, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Scan results:"
                               FontWeight="SemiBold"
                               Foreground="#1A5276"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Content="✕ Dismiss"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding DismissDiscoveryCommand}"
                        VerticalAlignment="Center" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DiscoveredDevices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DiscoveredDeviceViewModel}">
                                <Border Background="White"
                                        BorderBrush="#85C1E9"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,8"
                                        Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="#1A5276" />
                                        <TextBlock Text="{Binding Host}"
                                                   FontSize="11"
                                                   Foreground="#566573"
                                                   Margin="0,1,0,0" />
                                        <TextBlock Text="{Binding DeviceType}"
                                                   FontSize="11"
                                                   Foreground="#566573" />
                                        <TextBlock FontSize="10"
                                                   Foreground="#7F8C8D"
                                                   Margin="0,1,0,4">
                                            <Run Text="FW " /><Run Text="{Binding FirmwareVersion}" />
                                            <Run Text="  S/N " /><Run Text="{Binding Serial}" />
                                        </TextBlock>
                                        <Button Content="⊕ Import"
                                                Style="{StaticResource PrimaryButton}"
                                                FontSize="11"
                                                Padding="8,4"
                                                Command="{Binding DataContext.ImportDiscoveredCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Main content: list + edit form ─────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <!-- Edit panel column collapses to 0 when Border inside is Collapsed -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Device list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <ListView ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                          BorderThickness="0"
                          Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name"    Width="160"
                                            DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Type"    Width="110"
                                            DisplayMemberBinding="{Binding DeviceType}" />
                            <GridViewColumn Header="Host"    Width="130"
                                            DisplayMemberBinding="{Binding Host}" />
                            <GridViewColumn Header="Port"    Width="56"
                                            DisplayMemberBinding="{Binding Port}" />
                            <GridViewColumn Header="Default" Width="58">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsDefault, Mode=OneWay}"
                                                  IsEnabled="False"
                                                  HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Notes"   Width="180"
                                            DisplayMemberBinding="{Binding Notes}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />

            <!-- Edit / Add panel — Width="320" on the Border drives column width via Auto -->
            <Border Grid.Column="2"
                    Width="320"
                    Style="{StaticResource Card}"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Editing}" Margin="0">

                        <TextBlock Text="{Binding DataContext.EditingTitle,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="DISPLAY NAME" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="DEVICE TYPE" Style="{StaticResource FieldLabel}" />
                        <ComboBox IsEditable="True"
                                  Text="{Binding DeviceType, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="DM475V-LBL" />
                            <ComboBoxItem Content="DM475V-DPM" />
                            <ComboBoxItem Content="DM395V" />
                            <ComboBoxItem Content="DM390V" />
                            <ComboBoxItem Content="DMV-8072V" />
                        </ComboBox>

                        <TextBlock Text="HOST / IP ADDRESS" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="PORT" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="CONNECT TIMEOUT (ms)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ConnectMs, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="RESPONSE TIMEOUT (ms)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ResponseMs, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="IDLE GAP (ms)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding IdleGapMs, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="DMST LISTEN PORT (0 = poll mode)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding DmstPort, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="NOTES" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Height="60" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                        <CheckBox Content="Set as default device"
                                  IsChecked="{Binding IsDefault}"
                                  Margin="0,12,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Save"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding DataContext.SaveCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Margin="0,0,8,0" />
                            <Button Content="Cancel"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding DataContext.CancelCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── Status bar ──────────────────────────────────────────── -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,4"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource StatusText}" />
        </Border>
    </Grid>
</UserControl>
