#!/bin/bash
# Auto-push to GitHub after every commit/checkpoint made in Replit.
# GITHUB_TOKEN is a Replit secret available in the shell environment.
#
# Uses --force so it always wins regardless of what task agents may have
# pushed to GitHub directly. Task agent commits always arrive in the
# Replit branch via the gitsafe-backup merge path, so forcing never loses
# real work.  --force-with-lease is intentionally NOT used: it requires a
# prior git fetch to populate the tracking ref, and git fetch is blocked
# in the Replit main-agent sandbox.
#
# Push results are written to .github-sync-status for inspection at any time.
#
# IMPORTANT: This hook only runs if core.hooksPath = .githooks is set.
# Run once to configure: bash scripts/setup-git-hooks.sh

STATUS_FILE="$(git rev-parse --show-toplevel 2>/dev/null)/.github-sync-status"
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
TMPFILE=$(mktemp)
trap 'rm -f "$TMPFILE"' EXIT

_log() {
    echo "[post-commit] $*"
    echo "[$TIMESTAMP] $*" >> "$STATUS_FILE"
}

if [ -z "$GITHUB_TOKEN" ]; then
    _log "GITHUB_TOKEN not set — skipping GitHub push."
    exit 0
fi

GITHUB_URL="https://${GITHUB_TOKEN}@github.com/gw4-pips/vtccp.git"
LOCAL_SHA=$(git --no-optional-locks rev-parse --short HEAD)
_log "Pushing commit $LOCAL_SHA to GitHub..."

git push --force "$GITHUB_URL" HEAD:main > "$TMPFILE" 2>&1
PUSH_EXIT=$?

# Redact token before printing output.
sed "s|https://[^@]*@|https://***@|g" "$TMPFILE"

if [ "$PUSH_EXIT" -eq 0 ]; then
    _log "GitHub push OK — $LOCAL_SHA."
else
    _log "ERROR: push failed (exit $PUSH_EXIT). Run: bash scripts/sync-github.sh"
    echo "[post-commit] Replit commit still succeeded — your code is safe."
fi

# Always exit 0 so a push failure never blocks the Replit commit.
exit 0
